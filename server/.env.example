# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.  (.env 는 절대 커밋 금지 — .gitignore 처리됨)
PORT=8787

# 우리(개발자) API 키 — 서버에만 존재. 비워두면 MOCK 응답으로 동작(키 없이 데모 가능).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 데모 플랜: 하루 요청 한도
FREE_DAILY_LIMIT=20
PAID_DAILY_LIMIT=100

# 키가 있어도 강제로 목 응답을 쓰려면 1 (프론트 개발용)
MOCK=0
